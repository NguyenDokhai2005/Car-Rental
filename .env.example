DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carrental
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Chuoi ngau nhien dai it nhat 32 ky tu. Tao bang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
UPLOAD_DIR=./uploads
# Kho rieng cho anh GPLX. Khong duoc trung hay nam trong UPLOAD_DIR (thu muc do duoc phuc vu cong khai).
PRIVATE_UPLOAD_DIR=./private-uploads
# Trang ky thuat (/dev): dia chi may chu web de API goi thu. Mac dinh http://localhost:3000.
WEB_INTERNAL_URL=http://localhost:3000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
