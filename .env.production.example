# Sao chép thành .env.production trên máy chủ rồi điền giá trị thật. KHÔNG commit file .env.production.
DOMAIN=example.com
LETSENCRYPT_EMAIL=ban@example.com
# 1 = dùng Let's Encrypt staging để thử (chứng chỉ không được trình duyệt tin nhưng không bị giới hạn lần cấp)
LETSENCRYPT_STAGING=1

# Tạo bằng: openssl rand -hex 24   (dùng chuỗi hex để không có ký tự đặc biệt trong DATABASE_URL)
POSTGRES_PASSWORD=
# Tạo bằng: openssl rand -hex 48
JWT_ACCESS_SECRET=
